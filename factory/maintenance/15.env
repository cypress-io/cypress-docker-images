## This env file represents the versions of cypress/included images for Cypress 15.x patch releases.
## Follow the instructions for maintenance releases in the CONTRIBUTING document.

# Every 15.x cypress/included image is built on top of this cypress/browsers image,
# the last one released for Cypress 15. It is pinned by digest so that its contents never change.
# The versions below describe what the image contains. Do not change them.
NODE_VERSION='24.20.0'
CHROME_VERSION='152.0.7977.64-1'
EDGE_VERSION='151.0.4129.107-1'
FIREFOX_VERSION='154.0.1'

BROWSERS_IMAGE_TAG="node-${NODE_VERSION}-chrome-${CHROME_VERSION}-ff-${FIREFOX_VERSION}-edge-${EDGE_VERSION}"
BROWSERS_IMAGE_DIGEST='sha256:100f878135ace9ba8d8ea0ed05021cb9d0b7e45adde1d731a2a94bd7ffc6428a'

# Highest major version of TypeScript that Cypress 15 supports
TYPESCRIPT_VERSION='6'

# Cypress versions: https://www.npmjs.com/package/cypress
# Update only to a 15.x version to publish a new image.
CYPRESS_VERSION='15.21.1'

# Tags used for the cypress/included image.
# A change to INCLUDED_IMAGE_TAG causes a new image to be deployed.
INCLUDED_IMAGE_SHORT_TAG="${CYPRESS_VERSION}"
INCLUDED_IMAGE_TAG="cypress-${CYPRESS_VERSION}-${BROWSERS_IMAGE_TAG}"
